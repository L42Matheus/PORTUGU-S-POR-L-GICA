# Copie para .env e ajuste. Sem chave de IA, o app funciona com o conteúdo revisado.

# --- IA (opcional) ---
# Chave da API da Anthropic (Claude). Deixe vazia para o modo offline.
ANTHROPIC_API_KEY=
# anthropic | none  (none desliga a IA mesmo com chave presente)
PPL_AI_PROVIDER=
# Modelo e esforço de raciocínio (low | medium | high)
PPL_AI_MODEL=claude-opus-5-5
PPL_AI_EFFORT=medium

# --- Banco de dados ---
# Padrão: sqlite:///<projeto>/data/estudos.db
# No Railway, use um volume montado em /data:  sqlite:////data/estudos.db
PPL_DATABASE_URL=
